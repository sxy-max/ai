# OpenCode Go provider. Optional only when Anthropic is configured.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Anthropic provider. Leave the key empty to hide Claude automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Required in production. Use at least 12 characters; 16+ is recommended.
ACCESS_PASSWORD=

# Optional server-only model-token signing secret. If empty, a stable secret is
# derived from the configured provider API keys. Never share this with clients.
MODEL_TOKEN_SECRET=

# Exa MCP is used for web search and URL fetching.
# Anonymous hosted MCP works with rate limits; add a key only if needed.
EXA_MCP_URL=https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa
EXA_API_KEY=

# ============ 任务系统（Task Pipeline，PRD §9-§10、§61-§64）============
# PostgreSQL 是任务状态源。本地开发用 docker 起：
#   docker run -d --name goai-pg -e POSTGRES_USER=goai -e POSTGRES_PASSWORD=goai \
#     -e POSTGRES_DB=go_ai -p 5432:5432 postgres:16-alpine
# 然后执行 npm run db:migrate（幂等，可重复跑）。
DATABASE_URL=postgres://goai:goai@127.0.0.1:5432/go_ai

# Redis 负责事件广播（增强层；不可用时任务系统仍可用，实时性降级为轮询）。
# 本地端口建议避开 Windows 保留段（6379 在 6324-6423 内），用 16379：
#   docker run -d --name goai-redis -p 16379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:16379

# 产物与工作区落盘目录（生产挂 volume）。
ARTIFACTS_ROOT=/data/artifacts
WORKSPACES_ROOT=/data/workspaces
GO_AI_CONTROL_ROOT=/data/go-ai-control

# 任务规划/回答模型（未配置时任务走确定性规则生成器，仍可交付表格/文档等产物）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 任务后台执行进程（独立于 Next.js 服务）：
#   npx tsx scripts/task-worker.ts


SYSTEM_PROMPT=
MAX_OUTPUT_TOKENS=8192

# Optional global override. Anthropic IDs use the anthropic/ prefix.
# Example:
# FEATURED_MODELS=gpt-5.6-luna,anthropic/claude-sonnet-5,grok-4.5,kimi-k3,glm-5.2
FEATURED_MODELS=

# Optional Claude-only featured override. Prefixes are accepted but not required.
# Leave empty to use the built-in stable Claude recommendation when available.
ANTHROPIC_FEATURED_MODELS=

# Default false: only featured models are issued chat access tokens.
ALLOW_OTHER_MODELS=false

# Best-effort per-instance protection. Use Vercel Firewall and provider spend
# limits as the durable production controls.
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# AgentScope 2.0.6 internal runtime. Never expose this URL to browsers.
AGENTSCOPE_URL=http://agent-runtime:8000
AGENTSCOPE_WORKSPACE_ROOT=/data/agentscope-workspaces
GO_AI_CONTROL_ROOT=/data/go-ai-control
AGENTSCOPE_PROVIDER=deepseek
AGENTSCOPE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
